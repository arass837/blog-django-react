# Copy this file to backend/.env.local for local VS Code development.
# backend/.env.local is ignored by Git.

ENVIRONMENT=local
DEBUG=True
SECRET_KEY=django-insecure-local-development-only

# Local PostgreSQL database. This matches the existing local database name.
DB_NAME=oski
DB_USER=postgres
DB_PASSWORD=PUT_YOUR_LOCAL_POSTGRES_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432

# Optional alternative: use one PostgreSQL URL instead of DB_* values.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/oski

# Local React origins are already allowed by default, so these are optional.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
